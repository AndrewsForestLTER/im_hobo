"""
.. Note::
  This is a template. Copy this file to ``file_path.config`` (in the repository
  root, next to this file) and edit the paths and settings below for your
  machine. ``file_path.config`` is gitignored, so your local copy and its
  real paths are never committed.

.. Warning::
  Change file paths before use!
  Variable names must match the example EXACTLY.

Files can be located on a remote server or locally. Directories need to be
defined for:

* source files - QAQC will be attempted on every csv file in this directory
* local processing (should be local to the executing console)
* storage of processed data

.. Note::
  This file is directly executed by Python. Python syntax must be enforced.
  Use forward slashes (/) in file paths for cross-platform compatibility.
"""

dir_source_files = "/path/to/input"
dir_local_processing = "/path/to/hobo_temp"

# WARNING: dir_final_storage is cleared on every run.
# Do not point this at a directory containing other files - anything
# in this location will be deleted. Path is user-configurable but
# the cleanup behavior is not.
dir_final_storage = "/path/to/output"

# Optional legacy setting; ignored unless time_step is explicitly passed at
# runtime, for example:
# python -c "from MET_hobo.file_manager import FileHandling; FileHandling('file_path.config').manage(time_step='20min')"
time_step = "15min"      # time_step options: 5min, 15min, 20min
                         #ignored unless time_step is explicitly passed at runtime.

dedupe_mode = "prompt"   # "auto" = dedupe final output after each run
                         # "prompt" = ask at console before dedupe
                         # "off" (or key absent) = skip dedupe

# Optional. Where dedupe_mode writes deduplicated output. If absent (the
# default), it's a sibling of dir_final_storage named "<dir_final_storage
# name>_dedup" -- e.g. a dir_final_storage of .../bulk_clean defaults to
# .../bulk_clean_dedup. Set this to send dedupe output somewhere else instead.
# dir_dedupe_output = "/path/to/dedupe_output"

map_fname2dir = {"RS":"REFSTAND", "TS":"STREAMT", "PC":"PHENO"}

# Optional. Populate these to identify the TOA5 files written to dir_final_storage/TOA5.
# HOBO pendants aren't Campbell dataloggers, so none of these have a natural value;
# any key left absent is written as an empty field in the TOA5 header. Bulk mode only
# (final_subdirs=False) -- not written when routing output to per-project site dirs.
# toa5_station = "test"
# toa5_logger_model = "test"
# toa5_serial = "test"
# toa5_table_name = "test"
# toa5_os_version = "test"
# toa5_program_name = "test"
# toa5_program_sig = "test"