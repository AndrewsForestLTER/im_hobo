"""
.. Warning::
  Change file paths before use!
  Variable names must match the example EXACTLY.

Files can be located on a remote server or locally. Directories need to be defined for:

* source files - QAQC will be attempted on every csv file in this directory.
* local processing (should be local to the executing console)
* storage of processed data

.. Note::
  This file is directly executed by Python. Python syntax must be enforced.
  Use forward slashes (/) in file paths for cross-platform compatibility.

For time_step format, refer to pandas documentation on offset aliases.

Example:

dir_source_files = "/server/bulk_export_CSV"
dir_local_processing = "/home/user/HOBO_QA/"
dir_final_storage = "/server/bulk_export_clean"
time_step = '5min'

# Optional: map file prefix to a project directory in dir_final_storage
map_fname2dir = {"RS":"REFSTAND", "TS":"STREAMT"}
"""

# working directory
dir_source_files = "D:/Projects/MV008/2024/bulk"
dir_local_processing = "D:/HOBO_TEMP/"
dir_final_storage = "D:/Projects/MV008/2024/bulk_clean"

# time_step options: 5min, 15min, 20min
time_step = "20min"

map_fname2dir = {"RS":"REFSTAND", "TS":"STREAMT", "PC":"PHENO"}